# Copy to .env on the server (chmod 600 .env). Never commit .env.

# ---- Market data source: twelvedata (default), oanda or fxcm ----
DATA_PROVIDER=twelvedata

# ---- Twelve Data (DATA_PROVIDER=twelvedata) ----
# Free key (email sign-up): twelvedata.com -> Dashboard -> API Keys
TWELVEDATA_API_KEY=
TWELVEDATA_SYMBOL=XAU/USD
# Free plan = 800 credits/day: refresh every 150 s, every 20 s right after session/daily opens
TWELVEDATA_REFRESH_SECONDS=150
TWELVEDATA_FAST_REFRESH_SECONDS=20

# ---- OANDA v20 API (DATA_PROVIDER=oanda) ----
# Free practice (demo) account -> My Account -> Manage API Access -> Generate token
OANDA_API_TOKEN=
OANDA_ENVIRONMENT=practice
# Optional; the first account on the token is used when empty
OANDA_ACCOUNT_ID=
OANDA_INSTRUMENT=XAU_USD
# Title prefix of every embed
REPORT_BRAND=GOLD FXCM

# ---- FXCM ForexConnect (DATA_PROVIDER=fxcm, used by the fxcm-bridge service) ----
# Your FXCM Trading Station login. Start with a DEMO account.
FXCM_USERNAME=
FXCM_PASSWORD=
# Demo or Real
FXCM_CONNECTION=Demo
FXCM_URL=https://www.fxcorporate.com/Hosts.jsp
FXCM_SYMBOL=XAU/USD
# bid matches FXCM charts; previous_close is ForexConnect's default candle-open mode
FXCM_PRICE_SIDE=bid
FXCM_CANDLE_OPEN_MODE=previous_close
# Only for accounts that need them:
# FXCM_SESSION_ID=
# FXCM_PIN=

# ---- Discord ----
DISCORD_BOT_TOKEN=
DISCORD_DAILY_CHANNEL_ID=
# Leave empty to post session reports in the daily channel
DISCORD_SESSION_CHANNEL_ID=
# Optional: your server id, for instant slash-command registration
DISCORD_GUILD_ID=

# ---- Display / sessions (session times are New York time, DST-aware) ----
DISPLAY_TZ=Asia/Karachi
SESSION_TZ=America/New_York
SESSION_ASIA_OPEN=19:00
SESSION_LONDON_OPEN=03:00
SESSION_NEWYORK_OPEN=08:00
SESSION_NEWYORK_CLOSE=17:00

# ---- Analysis ----
DEALING_RANGE_MODE=previous_day
FVG_TIMEFRAMES=D1,H4,H1
FVG_MAX_PER_SIDE=6

LOG_LEVEL=INFO
